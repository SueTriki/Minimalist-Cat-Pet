{
  "manifest_version": 3,
  "name": "Minimalist Cat Pet",
  "version": "1.0",
  "description": "A transparent cat that gives you Catfirmations!",

  "icons": {
    "16": "images/standingcat.png",
    "48": "images/standingcat.png",
    "128": "images/standingcat.png"
  },

  "browser_specific_settings": {
    "gecko": {
      "id": "minimalist-cat-pet@extensions.local",
      "strict_min_version": "109.0"
    }
  },

  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "exclude_matches": [
        "https://addons.mozilla.org/*",
        "https://chrome.google.com/webstore/*"
      ],
      "js": ["content.js"],
      "css": ["content.css"],
      "run_at": "document_idle",
      "all_frames": false
    }
  ],

  "web_accessible_resources": [
    {
      "resources": ["images/*.png"],
      "matches": ["<all_urls>"]
    }
  ]
}
